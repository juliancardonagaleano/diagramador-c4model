{
  "$id": "https://github.com/juliancardonagaleano/iark-diagrams/schema/platform-document.schema.json",
  "title": "Documento de plataforma (IArk - DIAgrams)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": "1.0",
      "type": "string",
      "const": "1.0"
    },
    "workspace": {
      "default": {
        "name": "Arquitectura de plataforma"
      },
      "type": "object",
      "properties": {
        "name": {
          "default": "Arquitectura de plataforma",
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "currency": {
          "type": "string"
        }
      }
    },
    "environments": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "dev",
              "test",
              "staging",
              "prod",
              "dr"
            ]
          },
          "provider": {
            "type": "string"
          },
          "region": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "networks": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "environmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "parentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "exposure": {
            "type": "string",
            "enum": [
              "public",
              "private",
              "isolated"
            ]
          },
          "cidr": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "environmentId"
        ]
      }
    },
    "resources": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "cluster",
              "vm",
              "database",
              "cache",
              "queue",
              "storage",
              "load-balancer",
              "gateway",
              "dns",
              "secret-store",
              "registry",
              "region",
              "namespace",
              "certificate",
              "monitoring",
              "other"
            ]
          },
          "environmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "networkId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "technology": {
            "type": "string"
          },
          "version": {
            "type": "string"
          },
          "status": {
            "type": "string",
            "enum": [
              "planned",
              "provisioned",
              "decommissioned"
            ]
          },
          "iac": {
            "type": "boolean"
          },
          "owner": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "ref": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "monthlyCost": {
            "type": "number",
            "minimum": 0
          },
          "region": {
            "type": "string"
          },
          "cpuLimit": {
            "type": "string"
          },
          "memoryLimit": {
            "type": "string"
          },
          "expiresAt": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          }
        },
        "required": [
          "id",
          "name",
          "kind",
          "environmentId"
        ]
      }
    },
    "services": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "service",
              "worker",
              "job",
              "frontend"
            ]
          },
          "description": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "repo": {
            "type": "string"
          },
          "criticality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "slo": {
            "type": "string"
          },
          "sla": {
            "type": "string"
          },
          "external": {
            "type": "boolean"
          },
          "ref": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "deployments": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "serviceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "environmentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "hostId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "replicas": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "version": {
            "type": "string"
          },
          "monthlyCost": {
            "type": "number",
            "minimum": 0
          },
          "cpuLimit": {
            "type": "string"
          },
          "memoryLimit": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "serviceId",
          "environmentId",
          "hostId"
        ]
      }
    },
    "dependencies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "targetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "calls",
              "messages",
              "data"
            ]
          },
          "protocol": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "sourceId",
          "targetId",
          "kind"
        ]
      }
    },
    "pipelines": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "kind": {
            "type": "string",
            "enum": [
              "ci",
              "cd",
              "ci-cd",
              "iac"
            ]
          },
          "tool": {
            "type": "string"
          },
          "description": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "serviceIds": {
            "default": [],
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "provisions": {
            "type": "array",
            "items": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120
            }
          },
          "stages": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "environmentId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "approval": {
                  "type": "boolean"
                }
              },
              "required": [
                "environmentId"
              ]
            }
          }
        },
        "required": [
          "id",
          "name",
          "kind"
        ]
      }
    }
  }
}
