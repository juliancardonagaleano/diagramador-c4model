{
  "$id": "https://github.com/juliancardonagaleano/iark-diagrams/schema/integration-document.schema.json",
  "title": "Documento de integración (IArk - DIAgrams)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": "1.0",
      "type": "string",
      "const": "1.0"
    },
    "workspace": {
      "default": {
        "name": "Mapa de integración"
      },
      "type": "object",
      "properties": {
        "name": {
          "default": "Mapa de integración",
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "nodes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "system",
              "api",
              "gateway",
              "broker",
              "queue",
              "topic",
              "store"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          },
          "owner": {
            "type": "string"
          },
          "external": {
            "type": "boolean"
          },
          "parentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "ref": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "kind",
          "name"
        ]
      }
    },
    "contracts": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "format": {
            "type": "string",
            "enum": [
              "openapi",
              "asyncapi",
              "graphql",
              "protobuf",
              "avro",
              "json-schema",
              "wsdl",
              "other"
            ]
          },
          "version": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "format"
        ]
      }
    },
    "interactions": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "targetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "style": {
            "type": "string",
            "enum": [
              "request-response",
              "async-message",
              "event",
              "batch",
              "stream"
            ]
          },
          "protocol": {
            "type": "string"
          },
          "pattern": {
            "type": "string",
            "enum": [
              "content-based-router",
              "message-translator",
              "splitter",
              "aggregator",
              "filter",
              "enricher",
              "publish-subscribe",
              "polling-consumer",
              "idempotent-receiver",
              "dead-letter-channel",
              "saga",
              "circuit-breaker"
            ]
          },
          "contractId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string"
          },
          "dataObjects": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "criticality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high"
            ]
          }
        },
        "required": [
          "id",
          "sourceId",
          "targetId",
          "style"
        ]
      }
    },
    "flows": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "steps": {
            "default": [],
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "interactionId": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 120
                },
                "note": {
                  "type": "string"
                }
              },
              "required": [
                "interactionId"
              ]
            }
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    }
  }
}
