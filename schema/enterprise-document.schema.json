{
  "$id": "https://github.com/juliancardonagaleano/iark-diagrams/schema/enterprise-document.schema.json",
  "title": "Documento empresarial (IArk - DIAgrams)",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "version": {
      "default": "1.0",
      "type": "string",
      "const": "1.0"
    },
    "workspace": {
      "default": {
        "name": "Arquitectura empresarial"
      },
      "type": "object",
      "properties": {
        "name": {
          "default": "Arquitectura empresarial",
          "type": "string"
        },
        "description": {
          "type": "string"
        }
      }
    },
    "units": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "external": {
            "type": "boolean"
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "capabilities": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "parentId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "ownerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "importance": {
            "type": "string",
            "enum": [
              "differentiating",
              "core",
              "supporting"
            ]
          },
          "maturity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "processes": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "ownerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "applications": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "technology": {
            "type": "string"
          },
          "vendor": {
            "type": "string"
          },
          "ownerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "lifecycle": {
            "type": "string",
            "enum": [
              "planned",
              "active",
              "sunset",
              "retired"
            ]
          },
          "criticality": {
            "type": "string",
            "enum": [
              "low",
              "medium",
              "high",
              "critical"
            ]
          },
          "external": {
            "type": "boolean"
          },
          "ref": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "technologies": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "description": {
            "type": "string"
          },
          "kind": {
            "type": "string",
            "enum": [
              "platform",
              "infrastructure",
              "database",
              "runtime",
              "middleware",
              "service"
            ]
          },
          "version": {
            "type": "string"
          },
          "ownerId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "lifecycle": {
            "type": "string",
            "enum": [
              "planned",
              "active",
              "sunset",
              "retired"
            ]
          },
          "endOfLife": {
            "type": "string",
            "pattern": "^\\d{4}-(0[1-9]|1[0-2])(-(0[1-9]|[12]\\d|3[01]))?$"
          },
          "ref": {
            "type": "string"
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          }
        },
        "required": [
          "id",
          "name"
        ]
      }
    },
    "relations": {
      "default": [],
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "kind": {
            "type": "string",
            "enum": [
              "supports",
              "realizes",
              "runs-on",
              "depends-on"
            ]
          },
          "sourceId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "targetId": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "description": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "kind",
          "sourceId",
          "targetId"
        ]
      }
    }
  }
}
